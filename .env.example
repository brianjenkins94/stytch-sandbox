# Copy this file to .env and fill it in. (.env is gitignored.)

# ── Frontend ──────────────────────────────────────────────────────────
# Your Stytch public token (safe to expose in client code).
# Stytch dashboard → API Keys → Public tokens. Use the Test token for the POC.
VITE_STYTCH_PUBLIC_TOKEN=public-token-test-REPLACE-ME

# ── Backend (curl / Postman) — SERVER-SIDE ONLY ───────────────────────
# Basic auth for direct API calls. NOT VITE_-prefixed, so Vite never bundles these.
# Project ID is the Basic-auth username; the secret is the password — never commit it.
# Dashboard → Project Overview → Project ID & API keys (secret: click "View").
STYTCH_PROJECT_ID=project-test-REPLACE-ME
STYTCH_SECRET=secret-test-REPLACE-ME
STYTCH_ENV=test
