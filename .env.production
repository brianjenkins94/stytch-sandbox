# Committed on purpose: this holds ONLY the Stytch PUBLIC token, which is safe to expose in client
# code. Vite loads it automatically during `vite build`, so the GitHub Pages build always has the
# token baked in — no CI secret required. NEVER put the backend STYTCH_SECRET in this file.
VITE_STYTCH_PUBLIC_TOKEN=public-token-test-d1f0cc8a-d569-4d64-a7c8-04888cd2cdd7
