###
# @name authenticatePassword
# @description Authenticate with email + password. In a Test project the sandbox address returns 200 for
#              ANY password, so you can exercise the password flow without first creating a user.
POST {{baseUrl}}/v1/passwords/authenticate
Authorization: Basic {{projectId}} {{secret}}
Content-Type: application/json

{
  "email": "sandbox@stytch.com",
  "password": "any-password-works-in-sandbox",
  "session_duration_minutes": 60
}

{{
  test("status is 200", () => {
    if (response.statusCode !== 200) throw new Error(`Expected 200, got ${response.statusCode}`);
  });
  test("session_token is present", () => {
    if (!response.parsedBody.session_token) throw new Error("session_token missing from response");
  });

  exports.sessionToken = response.parsedBody.session_token;
}}

# Expected — 200 OK
# { "status_code": 200, "user_id": "user-test-...", "session_token": "<SESSION_TOKEN>", "session_jwt": "<SESSION_JWT>" }
